# Virelune Agent Village: machine settings.
# Copy this file to .env (the setup script does it for you) and fill in what this machine has.
# .env is git-ignored and excluded from ZIP exports. Never put real keys in .env.example.

# --- Server ---
# The village only listens on this machine. Do not change the host to 0.0.0.0.
VILLAGE_HOST=127.0.0.1
VILLAGE_PORT=4317
# Where the SQLite database and runtime files live. Relative paths are relative to the project folder.
VILLAGE_DATA_DIR=./data
# A name for this machine, shown in the village (for example: laptop, home-pc)
VILLAGE_MACHINE_NAME=

# --- Echo (OpenAI API) ---
OPENAI_API_KEY=

# --- Claude (Anthropic API, used by the Claude Agent SDK) ---
ANTHROPIC_API_KEY=

# --- Codex ---
# Leave empty to find `codex` on PATH. Codex uses its own login (`codex login`).
CODEX_PATH=

# --- Optional local and specialist tools (leave empty if not on this machine) ---
OLLAMA_HOST=http://127.0.0.1:11434
BLENDER_PATH=
# Command that starts the Blender Lab MCP server (from Blender Lab's setup instructions). Quote paths with spaces.
BLENDER_MCP_COMMAND=
UNREAL_ENGINE_ROOT=
# Command that starts the Unreal Engine MCP server, if you use one.
UNREAL_MCP_COMMAND=
AURA_MCP_COMMAND=
